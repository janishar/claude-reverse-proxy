# Copy to .env and fill in. Every script and VS Code launch config reads this file.
#   cp .env.example .env

# ── Upstream (the OpenAI-compatible API the proxy calls) ─────────────────────
TARGET_BASE_URL=https://integrate.api.nvidia.com
TARGET_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
PROVIDER_API_KEY=

# ── Downstream (what clients see) ────────────────────────────────────────────
PROXY_MODEL_NAME=claude-opus-5
PROXY_MODEL_ID=claude-opus-5
PROXY_MODEL_OWNED_BY=cloud-proxy

# Require this token on incoming requests (Authorization: Bearer … or x-api-key).
# Leave empty to run an open proxy on localhost.
PROXY_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Relay behaviour (optional) ───────────────────────────────────────────────
# auto (default) | translate | passthrough
# MESSAGES_UPSTREAM_MODE=auto
# Comma-separated substrings that mark a model name as Anthropic.
# ANTHROPIC_MODEL_MARKERS=opus,sonnet,haik,fable,anthropic,claude-
# Maximum request body size in megabytes.
# MAX_BODY_MB=50
