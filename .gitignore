# ─────────────────────────────────────────────────────────────────────────────
# Secrets and local configuration
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
.envrc
!.env.example
*.pem
*.key
secrets.json

# ─────────────────────────────────────────────────────────────────────────────
# Go
# ─────────────────────────────────────────────────────────────────────────────
# Built binaries. The Go binary is named after its directory, so it has no
# extension and needs naming explicitly.
goproxy/goproxy
goproxy/goproxy.exe

# Compiled objects and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries built with `go test -c`
*.test

# Coverage and profiling output
*.out
*.coverprofile
coverage.*
profile.cov
cpu.prof
mem.prof

# Go workspace and vendoring
go.work
go.work.sum
# vendor/

# Delve debugger binaries
__debug_*
debug.test

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

