*.tsbuildinfo

# Jest / Istanbul coverage
coverage/
.nyc_output/

# ─────────────────────────────────────────────────────────────────────────────
# Editors and IDEs
# ─────────────────────────────────────────────────────────────────────────────
# The VS Code debug setup is part of the project and is committed; everything
# else VS Code writes into .vscode/ is local.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml
*.swp
*.swo
*~
.\#*
\#*\#

# ─────────────────────────────────────────────────────────────────────────────
# Operating system
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

